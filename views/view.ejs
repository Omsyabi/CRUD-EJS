            <tr>
                <th>idnum</th>
                <th>firstname</th>
                <th>lastname</th>
                <th>age</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <%
                if(student.length > 0){
                    student.forEach((data=>{
                
            %>
            <tr>
                <td><%= data.idnum %></td>
