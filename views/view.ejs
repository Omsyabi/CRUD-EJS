                <td><%= data.lastname %></td>
                <td><%= data.age %></td>
                <td> <a href="/delete/<%= data.idnum %>" onclick=" return confirm('Do you want to delete this account?')">Delete </a></td>
            </tr>
            <%
                }))
            }
            %>
        </tbody>
    </table>
